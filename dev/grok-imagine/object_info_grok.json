  "name": "GrokVideoNode",
  "display_name": "Grok Video",
  "description": "Generate video from a prompt or an image",
  "python_module": "comfy_api_nodes.nodes_grok",
  "category": "partner/video/Grok",
  "output_node": false,
  "deprecated": false,
  "experimental": false,
  "dev_only": false,
  "api_node": true,
  "price_badge": {
   "engine": "jsonata",
   "depends_on": {
    "widgets": [
     {
      "name": "model",
      "type": "COMBO"
     },
     {
      "name": "duration",
      "type": "INT"
     },
     {
      "name": "resolution",
      "type": "COMBO"
     }
    ],
    "inputs": [
     "image"
    ],
    "input_groups": []
   },
   "expr": "\n                (\n                  $isLite := widgets.model = \"grok-imagine-video-1.5-lite\";\n                  $is15 := $contains(widgets.model, \"1.5\");\n                  $rate := $isLite\n                    ? (widgets.resolution = \"1080p\" ? 0.14 : (widgets.resolution = \"720p\" ? 0.03 : 0.02))\n                    : ($is15\n                        ? (widgets.resolution = \"1080p\" ? 0.25 : (widgets.resolution = \"720p\" ? 0.14 : 0.08))\n                        : (widgets.resolution = \"720p\" ? 0.07 : 0.05));\n                  $imgCost := $is15 ? 0.01 : 0.002;\n                  $base := $rate * widgets.duration;\n                  $total := inputs.image.connected ? $base + $imgCost : $base;\n                  {\"type\":\"usd\",\"usd\": $is15 ? $total * 1.43 : $total}\n                )\n                "
  },
