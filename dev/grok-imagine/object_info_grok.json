  "name": "GrokVideoReferenceNode",
  "display_name": "Grok Reference-to-Video",
  "description": "Generate video guided by reference images, with optional preset voice references.",
  "python_module": "comfy_api_nodes.nodes_grok",
  "category": "partner/video/Grok",
  "output_node": false,
  "deprecated": false,
  "experimental": false,
  "dev_only": false,
  "api_node": true,
  "price_badge": {
   "engine": "jsonata",
   "depends_on": {
    "widgets": [
     {
      "name": "model",
      "type": "COMFY_DYNAMICCOMBO_V3"
     },
     {
      "name": "model.duration",
      "type": "INT"
     },
     {
      "name": "model.resolution",
      "type": "COMBO"
     }
    ],
    "inputs": [],
    "input_groups": [
     "model.reference_images"
    ]
   },
   "expr": "\n                (\n                  $is15 := $contains(widgets.model, \"1.5\");\n                  $res := $lookup(widgets, \"model.resolution\");\n                  $dur := $lookup(widgets, \"model.duration\");\n                  $refs := $lookup(inputGroups, \"model.reference_images\");\n                  $rate := $is15\n                    ? ($res = \"720p\" ? 0.14 : 0.08)\n                    : ($res = \"720p\" ? 0.07 : 0.05);\n                  $imgCost := $is15 ? 0.01 : 0.002;\n                  $price := ($rate * $dur + $imgCost * $refs) * 1.43;\n                  {\"type\":\"usd\",\"usd\": $price}\n                )\n                "
  },
  "search_aliases": null,
  "essentials_category": null,
  "has_intermediate_output": false
